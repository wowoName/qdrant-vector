# ==============================================
# Vector Data Manager 环境配置
# ==============================================

# ---------- 基础配置 ----------
APP_NAME=Vector Data Manager
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=*
WORKERS=1

# ---------- 数据库配置 ----------
# SQLite（默认，轻量本地开发）
DB_DRIVER=sqlite+aiosqlite
DB_PATH=./data/vdm.db

# PostgreSQL（生产环境推荐，需安装 asyncpg）
# DB_DRIVER=postgresql+asyncpg
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=vdm_user
# DB_PASSWORD=vdm_password
# DB_NAME=vdm_db
# 连接池配置
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=3600

# ---------- Qdrant 配置 ----------
# Windows + Docker 环境建议用 127.0.0.1，避免 IPv6 被 wslrelay 拦截
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_USE_GRPC=false
QDRANT_COLLECTION_PREFIX=vdm_
# 启动时 Qdrant 同步策略: if_missing / always / rebuild / disabled
#   if_missing - 仅 Collection 不存在时同步（默认，安全）
#   always     - 每次启动都检查并增量同步缺失的向量
#   rebuild    - 每次启动都全量重建（谨慎使用）
#   disabled   - 不自动同步
QDRANT_SYNC_ON_START=if_missing

# ---------- 存储配置 ----------
STORAGE_BACKEND=local
STORAGE_ROOT=./data/storage

# ---------- 上传配置 ----------
UPLOAD_CHUNK_SIZE=5242880
UPLOAD_MAX_FILE_SIZE=10737418240
UPLOAD_EXPIRE_HOURS=24
UPLOAD_CONCURRENT_CHUNKS=3

# ---------- Embedding 模型配置 ----------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=./data/models
EMBEDDING_NORMALIZE=true

# ---------- Chunk 配置 ----------
CHUNK_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_MIN_SIZE=50

# ---------- LLM 配置 ----------
# 全局默认 Provider: ollama / ark / deepseek / qwen / openai
LLM_PROVIDER = ark
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# 按场景独立配置模型（不设置则使用全局默认）
# 对话场景
# CHAT_LLM_PROVIDER=ark
# CHAT_LLM_MODEL=ep-20240101000000-xxxxx
# 查询改写场景
# REWRITE_LLM_PROVIDER=
# REWRITE_LLM_MODEL=
# 摘要生成场景
# SUMMARY_LLM_PROVIDER=
# SUMMARY_LLM_MODEL=

# 火山方舟 (Ark)
ARK_API_KEY= ark-c7a7f603-5921-4213-aa9a-8609fff9f4f8-2cbbf
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL_ENDPOINT=deepseek-v4-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 阿里通义千问 (Qwen)
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------- 任务配置 ----------
TASK_MAX_WORKERS=4
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY=30

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_FILE=./data/logs/vdm.log

# ---------- Redis 配置（会话热存储 / 缓存） ----------
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_KEY_PREFIX=vdm:
REDIS_MAX_CONNECTIONS=20
# 会话热缓存 TTL（秒）：24 小时未访问则从 Redis 淘汰（DB 仍保留）
REDIS_SESSION_TTL=86400

# ---------- 对话 / 上下文配置 ----------
# 上下文窗口总 token（需小于模型实际 context window）
CHAT_CONTEXT_WINDOW_TOKENS=8000
# 系统提示 + 检索上下文 预留 token
CHAT_CONTEXT_RESERVE_TOKENS=3000
# 近期完整消息保留轮数（滑动窗口，user+assistant 算 1 轮）
CHAT_RECENT_TURNS=6
# 中期消息保留轮数（会被摘要压缩）
CHAT_MID_TURNS=10
# 压缩触发阈值：历史 token 超过预算的比例时触发压缩
CHAT_COMPACTION_THRESHOLD=0.8
# 工具结果最大 token（旧工具输出优先截断）
CHAT_TOOL_RESULT_MAX_TOKENS=500
