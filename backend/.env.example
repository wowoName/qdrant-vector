# ============================================================
# Vector Data Manager 环境配置
# 使用说明：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 按实际环境填写配置项（标注 <CHANGEME> 的为必填）
#   3. 生产环境务必修改 SECRET_KEY 及所有 API_KEY / 密码
# ============================================================

# ============================================================
# 基础应用配置
# ============================================================

# 应用名称，显示在日志、标题等位置
APP_NAME=Vector Data Manager
# 运行环境：development（开发）/ production（生产）/ testing（测试）
APP_ENV=development
# 是否开启调试模式，true 时会输出更详细的错误信息，生产环境建议设为 false
APP_DEBUG=true
# 服务监听地址，0.0.0.0 表示监听所有网卡，局域网内其他设备可以访问
APP_HOST=0.0.0.0
# 服务监听端口
APP_PORT=8000
# 应用密钥，用于 Session、Token 加密等，生产环境务必修改为随机字符串
SECRET_KEY=<CHANGEME>
# 允许的跨域来源，多个用逗号分隔，* 表示允许所有来源（生产环境建议指定具体域名）
CORS_ORIGINS=*
# uvicorn worker 进程数（生产环境建议按 CPU 核数设置，开发模式固定为 1）
WORKERS=1
# 应用时区：所有时间戳按此时区生成与展示（默认北京时间；数据库会话时区同步设置为该值）
APP_TIMEZONE=Asia/Shanghai

# ============================================================
# 认证 / SaaS 配置
# ============================================================

# JWT 有效期（天）
JWT_EXPIRE_DAYS=7
# 新注册租户的试用有效期（天）：自注册租户注册后自动获得的有效天数，到期须由管理员续期
TENANT_TRIAL_DAYS=7
# 邮箱验证码有效期（分钟）
EMAIL_CODE_EXPIRE_MINUTES=10
# 邮件验证码发送间隔（秒，防刷）
EMAIL_CODE_RESEND_SECONDS=60
# SMTP 邮件配置（用于发送注册验证码；不配置时开发模式下验证码写入日志并随接口返回）
# 示例（QQ 邮箱）：SMTP_HOST=smtp.qq.com SMTP_PORT=465 SMTP_USE_SSL=true
# 示例（163 邮箱）：SMTP_HOST=smtp.163.com SMTP_PORT=465 SMTP_USE_SSL=true
SMTP_HOST=
SMTP_PORT=465
# 发件邮箱账号
SMTP_USER=
# 邮箱 SMTP 授权码（非登录密码）：QQ邮箱→设置→账户→开启SMTP服务→获取16位授权码
SMTP_PASSWORD=
# 发件人，留空则使用 SMTP_USER
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# ============================================================
# 主数据库配置（业务元数据 + SaaS 用户体系：用户/集合/文档/任务 等）
# SaaS 系统：用户注册信息统一存 PostgreSQL
# ============================================================

# 数据库驱动：系统统一使用 PostgreSQL（postgresql+asyncpg）
DB_DRIVER=postgresql+asyncpg
# PostgreSQL 连接配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<CHANGEME>
DB_NAME=vdm_db
# 单次数据库命令超时（秒），超时后任务报错并进入重试流程
DB_COMMAND_TIMEOUT=60

# ============================================================
# 对话数据库配置（对话记录：会话/消息/摘要）
# 独立存储到 PostgreSQL，不影响业务元数据
# ============================================================

# 是否启用独立的对话数据库（true=PostgreSQL，false=使用主库）
CHAT_DB_ENABLED=true
# 对话数据库驱动
CHAT_DB_DRIVER=postgresql+asyncpg
# 对话数据库地址
CHAT_DB_HOST=127.0.0.1
# 对话数据库端口
CHAT_DB_PORT=5432
# 对话数据库用户名
CHAT_DB_USER=postgres
# 对话数据库密码（生产环境务必修改）
CHAT_DB_PASSWORD=<CHANGEME>
# 对话数据库名
CHAT_DB_NAME=vdm_db
# 连接池大小
CHAT_DB_POOL_SIZE=10
# 最大溢出连接数
CHAT_DB_MAX_OVERFLOW=5
# 连接回收时间（秒）
CHAT_DB_POOL_RECYCLE=3600

# ============================================================
# Qdrant 向量数据库配置
# 需要本地启动 Qdrant，或使用 docker compose up -d qdrant
# 注意：Windows + Docker 环境下建议使用 127.0.0.1 而非 localhost
#       避免 IPv6(::1) 被 wslrelay 拦截导致 502 错误
# ============================================================

# Qdrant 服务地址
QDRANT_HOST=127.0.0.1
# Qdrant HTTP 服务端口，默认 6333
QDRANT_PORT=6333
# Qdrant API Key（如果启用了认证），本地开发可留空
QDRANT_API_KEY=
# 是否使用 gRPC 协议，true 时走 6334 端口，性能更好
QDRANT_USE_GRPC=false
# 集合名前缀，所有创建的 Qdrant 集合都会加上此前缀，避免与其他项目冲突
QDRANT_COLLECTION_PREFIX=vdm_
# 启动时 Qdrant 同步策略: if_missing / always / rebuild / disabled
#   if_missing - 仅 Collection 不存在时同步（默认，安全）
#   always     - 每次启动都检查并增量同步缺失的向量
#   rebuild    - 每次启动都全量重建（谨慎使用）
#   disabled   - 不自动同步
QDRANT_SYNC_ON_START=if_missing

# ============================================================
# 文件存储配置
# ============================================================

# 存储后端类型：local（本地文件系统）/ s3（S3 兼容对象存储）
STORAGE_BACKEND=local
# 本地存储根目录（相对 backend 目录），上传的文件会保存在这里
STORAGE_ROOT=./data/storage

# ============================================================
# 文件上传配置
# ============================================================

# 分片上传时每个分片的大小（字节），默认 5MB
UPLOAD_CHUNK_SIZE=5242880
# 允许上传的单个文件最大大小（字节），默认 10GB
UPLOAD_MAX_FILE_SIZE=10737418240
# 分片上传会话过期时间（小时），超时未完成的上传会被清理
UPLOAD_EXPIRE_HOURS=24
# 分片上传并发数（同时下载/写入的分片数）
UPLOAD_CONCURRENT_CHUNKS=3

# ============================================================
# Embedding 模型配置
# 模型名可以是本地目录名（放在 data/models/ 下）或 HuggingFace repo 名
# 推荐小模型：bge-small-zh-v1.5（512维，速度快，适合中文）
# 推荐大模型：bge-m3（1024维，支持多语言，质量高）
# ============================================================

# Embedding 模型名称/路径
# 推荐：bge-small-zh-v1.5（512维，CPU 速度快 5~10 倍，中文效果好）
# 备选：BAAI/bge-m3（1024维，多语言，质量高但 CPU 慢）
EMBEDDING_MODEL=bge-small-zh-v1.5
# 推理设备：auto（自动选择）/ cpu / cuda（需要 GPU 版 PyTorch）
EMBEDDING_DEVICE=cpu
# 批量推理时的批次大小，小模型可以用更大的 batch 提升吞吐量
EMBEDDING_BATCH_SIZE=64
# 模型缓存目录，从 HuggingFace 下载的模型会存放在这里
EMBEDDING_CACHE_DIR=./data/models
# 是否对向量做 L2 归一化，true 时余弦相似度等价于点积，检索更高效
EMBEDDING_NORMALIZE=true
# 离线模式：强制从本地加载模型，不访问 HuggingFace（模型必须已下载且完整）
EMBEDDING_OFFLINE=false
# HuggingFace 镜像源地址，国内建议用 https://hf-mirror.com 加速下载
HF_ENDPOINT=https://hf-mirror.com

# ============================================================
# 文档切片（Chunk）配置
# ============================================================

# 切片策略：
#   fixed             - 固定大小切片
#   recursive         - 递归字符切片（默认，推荐，尽量在语义边界处切分）
#   semantic          - 语义感知切片（基于 embedding 相似度，质量高但速度慢）
#   parent_child      - 父子块切片（检索质量最好，子块检索 + 父块返回）
CHUNK_STRATEGY=recursive
# 每个切片的目标大小（字符数），建议 300~1000
CHUNK_SIZE=600
# 相邻切片之间的重叠字符数，保留上下文连贯性，建议为 chunk_size 的 10%~20%
CHUNK_OVERLAP=75
# 最小切片大小（字符数），小于此值的切片会被合并或丢弃
CHUNK_MIN_SIZE=200

# ============================================================
# 表格切片配置（Excel / CSV）
# 速度优化：row_group 模式比 record 模式快约 10 倍
# ============================================================

# 表格切片模式：
#   record      - 记录模式，一行一个 chunk（精度最高，最慢）
#   row         - 行级，一行一个 chunk
#   row_group   - 行组，N 行一个 chunk（推荐，速度快 5~10 倍）
#   column_group- 列组，按列分组切片
TABULAR_CHUNK_MODE=row_group
# 行组模式下每组行数（越大 chunk 越少，处理越快）
TABULAR_ROWS_PER_CHUNK=10
# 每个 chunk 是否包含表头信息（推荐开启，增强检索语义）
TABULAR_INCLUDE_HEADERS=true

# ============================================================
# LLM 大语言模型配置
# 全局默认 Provider: ollama / ark / deepseek / qwen / openai
# ============================================================

# 全局默认 LLM 服务商
LLM_PROVIDER=ark
# 全局默认模型标识，需与 LLM_PROVIDER 对应
# ark：填写方舟控制台的 Model ID 或 Endpoint ID（ep-xxxxx），不能使用展示名
# ollama 示例：qwen2.5:7b；deepseek 示例：deepseek-chat
LLM_MODEL=
# 采样温度，0~1 之间，值越大越随机创造性越强，值越小越稳定
LLM_TEMPERATURE=0.7
# 单次生成最大 token 数
LLM_MAX_TOKENS=2048
# 请求超时时间（秒）
LLM_TIMEOUT=120

# ------------------------------------------------------------
# 按场景独立配置 LLM（不设置则使用全局默认）
# ------------------------------------------------------------
# 对话场景使用的模型
# CHAT_LLM_PROVIDER=ark
# CHAT_LLM_MODEL=ep-20240101000000-xxxxx
# 查询改写场景使用的模型
# REWRITE_LLM_PROVIDER=
# REWRITE_LLM_MODEL=
# 摘要生成场景使用的模型
# SUMMARY_LLM_PROVIDER=
# SUMMARY_LLM_MODEL=

# ============================================================
# 火山方舟 (Ark) 配置
# ============================================================

# 火山方舟 API Key（生产环境务必修改，请勿提交真实 Key 到代码库）
ARK_API_KEY=
# 火山方舟 API 基础地址
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型统一使用上方 LLM_MODEL，或对应场景的 *_LLM_MODEL

# ============================================================
# DeepSeek 配置
# ============================================================

# DeepSeek API Key
DEEPSEEK_API_KEY=
# DeepSeek API 基础地址
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ============================================================
# 阿里通义千问 (Qwen) 配置
# ============================================================

# 通义千问 API Key（DashScope）
DASHSCOPE_API_KEY=
# 通义千问 OpenAI 兼容模式 API 基础地址
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================================
# Ollama 配置（本地模型）
# ============================================================

# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434
# Ollama 模型名称，需先执行 ollama pull 拉取
OLLAMA_MODEL=qwen2.5:7b

# ============================================================
# 任务处理配置
# ============================================================

# 同时处理的最大任务数（文档解析、向量化等后台任务）
TASK_MAX_WORKERS=2
# 任务失败最大重试次数
TASK_MAX_RETRIES=3
# 任务重试延迟时间（秒）
TASK_RETRY_DELAY=30

# ============================================================
# 日志配置
# ============================================================

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 日志文件路径（相对 backend 目录）
LOG_FILE=./data/logs/vdm.log

# ============================================================
# Redis 配置（会话热存储 / 缓存）
# 需要先启动 Redis：docker compose up -d redis
# ============================================================

# 是否启用 Redis（false 时只用 DB 持久化，Redis 挂了也会自动降级）
REDIS_ENABLED=true
# Redis 服务地址
REDIS_HOST=127.0.0.1
# Redis 端口，默认 6379
REDIS_PORT=6379
# Redis DB 编号
REDIS_DB=0
# Redis 密码，本地开发可留空
REDIS_PASSWORD=
# Redis Key 前缀，避免与其他项目冲突
REDIS_KEY_PREFIX=vdm:
# 最大连接数
REDIS_MAX_CONNECTIONS=20
# 会话热缓存 TTL（秒）：24 小时未访问则从 Redis 淘汰（DB 仍保留完整数据）
REDIS_SESSION_TTL=86400

# ============================================================
# 对话 / 上下文窗口配置
# ============================================================

# 上下文窗口总 token 数（需小于模型实际支持的 context window）
CHAT_CONTEXT_WINDOW_TOKENS=8000
# 系统提示 + 检索上下文 预留的 token 预算
CHAT_CONTEXT_RESERVE_TOKENS=3000
# 近期完整消息保留轮数（滑动窗口，user+assistant 算 1 轮）
CHAT_RECENT_TURNS=6
# 中期消息保留轮数（超出近期窗口的会被摘要压缩）
CHAT_MID_TURNS=10
# 压缩触发阈值：历史消息 token 超过预算的比例时触发滚动摘要
CHAT_COMPACTION_THRESHOLD=0.8
# 工具结果最大 token 数（旧的工具输出优先截断）
CHAT_TOOL_RESULT_MAX_TOKENS=500

# ============================================================
# 流式输出 / 生成阶段配置
# ============================================================

# 合成阶段是否真流式（LLM 增量直透传，而非整段生成完再一次性下发）
SMART_QUERY_STREAM_SYNTHESIS=true
# 合成阶段是否注入对话历史（多轮上下文理解；设为 false 即回退到"无历史"行为）
SMART_QUERY_USE_HISTORY=true
# SSE 心跳间隔（秒）：前置阶段无内容时保活，防止网关空闲断连
STREAM_HEARTBEAT_SEC=12
